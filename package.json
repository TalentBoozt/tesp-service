{
  "name": "tesp-backend",
  "version": "1.0.0",
  "description": "Talnova Enterprise Survey Platform (TESP) - Node.js DDD Modular Monolith",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "seed": "ts-node-dev --transpile-only src/shared/infrastructure/database/seed.ts",
    "db:seed": "ts-node src/shared/infrastructure/database/seeds/demo-seed.ts",
    "smoke-test": "node scripts/production-smoke-test.js",
    "cert:e2e": "node scripts/e2e-production-readiness-cert.js"
  },
  "keywords": [],
  "author": "Talnova Engineering",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
